<%= form_with model: @article do |form| %>



<% if @article.errors.any? %>
  <h2>Errors:</h2>

  <ul>
    <% @article.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

  <p>
    <%= form.label :title %><br>
    <%= form.text_field :title %>
  </p>

  <p>
    <%= form.label :body %><br>
    <%= form.text_area :body %>
  </p>

  <p>
<%= form.submit(@article.new_record? ? "Create Article" : "Update Article") %>  </p>
<% end %>