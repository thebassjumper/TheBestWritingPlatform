<h1><%= @article.title %></h1>

<p><%= @article.body %></p>

<h2>Comments</h2>

<% @article.comments.each do |comment| %>
  <p><%= comment.body %></p>
<% end %>

<%= link_to "Back", root_path %>

<%= link_to "Edit", "/articles/#{@article.id}/edit" %>

<%= button_to "Delete", article_path(@article), method: :delete, data: { turbo_confirm: "Are you sure?" } %>

